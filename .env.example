# 复制本文件为 .env 并填入配置
OPENAI_API_KEY=sk-your-deepseek-api-key
OPENAI_BASE_URL=https://api.deepseek.com
TP_OPENAI_MODEL=deepseek-chat

# 真实数据（可选）：高德 Web 服务 Key（免费申请），填后酒店/景点为真实数据
AMAP_KEY=
# 第三方航班接口（可选，需自备）
FLIGHT_API_URL=
FLIGHT_API_KEY=
# 关系型数据库（可选）：填后用户/会话/对话等存入 SQLite；未设置则用 JSON
# TP_DB_FILE=data/travel_planner.db
