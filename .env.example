# 复制本文件为 .env 并填入配置
OPENAI_API_KEY=sk-your-deepseek-api-key
OPENAI_BASE_URL=https://api.deepseek.com
TP_OPENAI_MODEL=deepseek-chat

# RAG Embedding（可选）：DeepSeek 无 embedding 接口，
# 可配硅基流动/OpenAI/智谱等 OpenAI 兼容服务；留空则回退 TF-IDF
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# 真实数据（可选）：高德 Web 服务 Key（免费申请），填后酒店/景点为真实数据
AMAP_KEY=
# 第三方航班接口（可选，需自备）
FLIGHT_API_URL=
FLIGHT_API_KEY=
# 关系型数据库（可选）：填后用户/会话/对话等存入 SQLite；未设置则用 JSON
# TP_DB_FILE=data/travel_planner.db

# LLM 调用日志（python_backend/llm_log.py）
# 默认写到 <项目根>/data/llm_calls.jsonl；要换位置就开下面这行
# TP_LLM_LOG=data/llm_calls.jsonl
# 置 1 时把 prompt 全文也写进日志（默认只写长度：省磁盘 + 不落用户隐私）
# TP_LOG_FULL_PROMPT=1
